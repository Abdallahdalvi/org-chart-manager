# Copy to .env.selfhost. Never commit or share the filled-in file.
# Use your HTTPS domain when accessing from another computer.
APP_ORIGIN=http://localhost:3080
APP_USERNAME=marketing
APP_PASSWORD=replace-with-a-random-password-of-at-least-16-characters
SUPABASE_URL=https://supabase.dalvi.cloud
# Server-only secret/service_role key, NOT an anon/publishable key.
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-server-only-key
# Enable only for your own isolated private Supabase Docker network.
SUPABASE_ALLOW_HTTP=false
# Default: only the CasaOS machine itself can reach the app port.
# Put an HTTPS reverse proxy in front; expose more widely only deliberately.
BIND_IP=127.0.0.1
APP_PORT=3080
