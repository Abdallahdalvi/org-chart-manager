# Copy to .env.selfhost. Never commit or share the filled-in file.
# Configure Cloudflare Access BEFORE switching your server to this mode.
# See CLOUDFLARE-ACCESS.md. Existing installs without APP_AUTH_MODE keep password mode.
APP_ORIGIN=https://orgchart.dalvi.cloud
APP_AUTH_MODE=cloudflare
CF_ACCESS_TEAM_DOMAIN=replace-with-your-team.cloudflareaccess.com
CF_ACCESS_AUD=replace-with-this-apps-64-character-audience-tag
# Exact emails, comma-separated. Unlisted emails are denied even if Access allows them.
APP_EDITOR_EMAILS=abdallah.dalvi@ubiqedge.com
APP_HR_EMAILS=hr@ubiqedge.com
APP_APPROVER_EMAILS=
APP_VIEWER_EMAILS=
# Legacy password mode only: APP_AUTH_MODE=basic. Ignored entirely in cloudflare mode.
APP_USERNAME=
APP_PASSWORD=
SUPABASE_URL=https://supabase.dalvi.cloud
# Server-only secret/service_role key, NOT an anon/publishable key.
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-server-only-key
# Enable only for your own isolated private Supabase Docker network.
SUPABASE_ALLOW_HTTP=false
# Default: only the CasaOS machine itself can reach the app port.
# Put an HTTPS reverse proxy in front; expose more widely only deliberately.
BIND_IP=127.0.0.1
APP_PORT=3080
